{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "build/**/*.ts",
        "vite.config.*",
        "vitest.config.*",
        "cypress.config.*",
        "nightwatch.conf.*",
        "playwright.config.*"
    ]
}
