{
    "name": "client-portal",
    "type": "module",
    "version": "2.10.0",
    "private": false,
    "packageManager": "pnpm@11.5.1",
    "scripts": {
        "dev": "vite",
        "dev-network": "vite --host --mode development-network",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:staging": "run-p type-check build-only:staging",
        "preview": "vite preview",
        "build-only": "vite build",
        "build-only:staging": "vite build --mode staging",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "lint": "eslint --fix",
        "prepush": "run-p --print-label --continue-on-error type-check lint",
        "check": "pnpm run '/^(lint|type-check)$/'",
        "update-locals": "node --env-file=.env.development update-locals.js",
        "update-packages": "pnpm ncu"
    },
    "dependencies": {
        "@elastic/apm-rum-vue": "2.1.14",
        "@intlify/unplugin-vue-i18n": "11.2.3",
        "@medrunner/api-client": "0.7.0-beta.25",
        "@tailwindcss/vite": "4.3.0",
        "@vueform/multiselect": "2.6.11",
        "autosize": "6.0.1",
        "date-fns": "4.4.0",
        "dompurify": "3.4.7",
        "echarts": "6.1.0",
        "flowbite": "4.0.2",
        "markdown-it": "14.2.0",
        "pinia": "3.0.4",
        "vue": "3.5.35",
        "vue-echarts": "8.0.1",
        "vue-eslint-parser": "10.4.0",
        "vue-i18n": "11.4.4",
        "vue-router": "5.1.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "9.0.0",
        "@tailwindcss/forms": "0.5.11",
        "@tailwindcss/typography": "0.5.19",
        "@tsconfig/node24": "24.0.4",
        "@types/autosize": "4.0.3",
        "@types/markdown-it": "14.1.2",
        "@types/node": "24.12.4",
        "@vitejs/plugin-vue": "6.0.7",
        "@vue/tsconfig": "0.9.1",
        "dotenv": "17.4.2",
        "eslint": "10.4.1",
        "eslint-plugin-better-tailwindcss": "4.5.0",
        "npm-run-all2": "9.0.1",
        "tailwindcss": "4.3.0",
        "typescript": "6.0.3",
        "vite": "8.0.14",
        "vue-tsc": "3.3.3",
        "yauzl": "3.3.2"
    }
}
